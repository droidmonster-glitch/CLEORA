# Local development only. Generate each value separately, e.g. python -c "import secrets; print(secrets.token_hex(24))"
# Use hexadecimal characters for the DB password to avoid URL-encoding issues.
POSTGRES_PASSWORD=
AREZKI_TOKEN=
SARAH_TOKEN=
# Optional: sends fictitious questions and FAQ to Mistral; billed by provider.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Supabase CLEORA — alternative to local PostgreSQL
# Copy the Session pooler connection from Connect, change scheme to postgresql+psycopg://
# URL-encode the password and append ?sslmode=require. Never commit the real value.
SUPABASE_DATABASE_URL=
SUPABASE_PUBLISHABLE_KEY=sb_publishable_C7-1pnj3Ol6Pdtfmlzrq3g_HP8wjPVE
# Publishable key is intentionally public, protected by RLS; NOT a service-role key.
